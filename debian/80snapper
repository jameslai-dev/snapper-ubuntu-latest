  DPkg::Post-Invoke { "if [ -x /usr/bin/snapper -a `ls /var/tmp/snapper-apt >/dev/null 2>&1` ]; then snapper create -d apt -c number -t post --pre-number=`cat /var/tmp/snapper-apt` || true ; fi"; };
