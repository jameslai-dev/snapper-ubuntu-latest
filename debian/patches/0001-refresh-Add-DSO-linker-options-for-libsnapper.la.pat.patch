From: Nicolas Dandrimont <nicolas.dandrimont@crans.org>
Date: Wed, 4 Dec 2013 23:15:39 +0100
Subject: Add DSO linker options for libsnapper.la

---
 client/Makefile.am           | 4 ++--
 client/utils/Makefile.am     | 2 +-
 examples/c++-lib/Makefile.am | 3 ++-
 server/Makefile.am           | 3 ++-
 testsuite-cmp/Makefile.am    | 2 +-
 testsuite-real/Makefile.am   | 2 +-
 testsuite/Makefile.am        | 2 +-
 7 files changed, 10 insertions(+), 8 deletions(-)

Index: snapper/client/Makefile.am
===================================================================
--- snapper.orig/client/Makefile.am
+++ snapper/client/Makefile.am
@@ -26,6 +26,9 @@ snapper_SOURCES =					\
 
 snapper_LDADD = 			\
 	../snapper/libsnapper.la	\
+        -lboost_thread			\
+        -lboost_system			\
+        -lxml2 -lacl -lz -lm		\
 	utils/libutils.la		\
 	Command/libcommand.la		\
 	../dbus/libdbus.la
@@ -45,7 +48,7 @@ systemd_helper_SOURCES =		\
 	misc.cc		misc.h		\
 	errors.cc	errors.h
 
-systemd_helper_LDADD = ../snapper/libsnapper.la utils/libutils.la ../dbus/libdbus.la
+systemd_helper_LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm utils/libutils.la ../dbus/libdbus.la
 
 if ENABLE_BTRFS
 
Index: snapper/client/utils/Makefile.am
===================================================================
--- snapper.orig/client/utils/Makefile.am
+++ snapper/client/utils/Makefile.am
@@ -19,5 +19,5 @@ libutils_la_SOURCES =				\
 	JsonFormatter.cc    JsonFormatter.h
 
 
-libutils_la_LIBADD = ../../snapper/libsnapper.la
+libutils_la_LIBADD = ../../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
Index: snapper/examples/c++-lib/Makefile.am
===================================================================
--- snapper.orig/examples/c++-lib/Makefile.am
+++ snapper/examples/c++-lib/Makefile.am
@@ -5,7 +5,8 @@
 AM_CPPFLAGS = -I$(top_srcdir)
 
 LDADD = ../../snapper/libsnapper.la
-AM_LDFLAGS = -lboost_system
+AM_LDFLAGS = -lboost_system \
+             -lboost_thread -lxml2 -lacl -lz -lm
 
 noinst_PROGRAMS = List ListAll Create CmpDirs CreateNumber CreateTimeline
 
Index: snapper/server/Makefile.am
===================================================================
--- snapper.orig/server/Makefile.am
+++ snapper/server/Makefile.am
@@ -14,4 +14,5 @@ snapperd_SOURCES =					\
 	Types.cc		Types.h
 
 snapperd_LDADD = ../snapper/libsnapper.la ../dbus/libdbus.la -lrt
-snapperd_LDFLAGS = -lboost_system -lboost_thread -lpthread
+snapperd_LDFLAGS = -lboost_system -lboost_thread -lpthread \
+                   -lxml2 -lacl -lz -lm
Index: snapper/testsuite-cmp/Makefile.am
===================================================================
--- snapper.orig/testsuite-cmp/Makefile.am
+++ snapper/testsuite-cmp/Makefile.am
@@ -5,7 +5,7 @@
 AM_CPPFLAGS = -I$(top_srcdir)
 AM_LDFLAGS = -lboost_system
 
-LDADD = ../snapper/libsnapper.la
+LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 noinst_SCRIPTS = run-all
 
Index: snapper/testsuite-real/Makefile.am
===================================================================
--- snapper.orig/testsuite-real/Makefile.am
+++ snapper/testsuite-real/Makefile.am
@@ -6,7 +6,7 @@ CXXFLAGS += -std=gnu++0x
 
 AM_CPPFLAGS = -I$(top_srcdir)
 
-LDADD = ../snapper/libsnapper.la
+LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 if HAVE_XATTRS
 TMP_XATST = xattrs1 xattrs2 xattrs3 xattrs4
Index: snapper/testsuite/Makefile.am
===================================================================
--- snapper.orig/testsuite/Makefile.am
+++ snapper/testsuite/Makefile.am
@@ -4,7 +4,7 @@
 
 AM_CPPFLAGS = -I$(top_srcdir) $(DBUS_CFLAGS)
 
-LDADD = ../snapper/libsnapper.la ../dbus/libdbus.la -lboost_unit_test_framework
+LDADD = ../snapper/libsnapper.la ../dbus/libdbus.la -lboost_unit_test_framework -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 check_PROGRAMS = sysconfig-get1.test dirname1.test basename1.test		    \
 	equal-date.test dbus-escape.test cmp-lt.test humanstring.test table.test    \
