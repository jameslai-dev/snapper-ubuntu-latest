From: Arvin Schnell <aschnell@suse.de>
Date: Fri, 12 Jun 2026 09:48:08 +0200
Subject: [PATCH 42/65] - add dependencies to dbus

---
 data/backup.service       | 3 +++
 data/boot.service         | 3 +++
 data/cleanup.service      | 3 +++
 data/snapper-sync.service | 4 ++--
 data/timeline.service     | 3 +++
 package/snapper.changes   | 5 +++++
 6 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/data/backup.service b/data/backup.service
index 87b5e475..0843a236 100644
--- a/data/backup.service
+++ b/data/backup.service
@@ -1,6 +1,9 @@
 [Unit]
 Description=Backup of Snapper Snapshots
 Documentation=man:snbk(8)
+Requires=dbus.service
+After=dbus.service
+Requires=nss-user-lookup.target
 After=nss-user-lookup.target
 
 [Service]
diff --git a/data/boot.service b/data/boot.service
index ef0f71af..cbd5a933 100644
--- a/data/boot.service
+++ b/data/boot.service
@@ -1,6 +1,9 @@
 [Unit]
 Description=Take snapper snapshot of root on boot
 ConditionPathExists=/etc/snapper/configs/root
+Requires=dbus.service
+After=dbus.service
+Requires=nss-user-lookup.target
 After=nss-user-lookup.target
 
 [Service]
diff --git a/data/cleanup.service b/data/cleanup.service
index c5fbb229..6a3290b5 100644
--- a/data/cleanup.service
+++ b/data/cleanup.service
@@ -1,6 +1,9 @@
 [Unit]
 Description=Daily Cleanup of Snapper Snapshots
 Documentation=man:snapper(8) man:snapper-configs(5)
+Requires=dbus.service
+After=dbus.service
+Requires=nss-user-lookup.target
 After=nss-user-lookup.target
 
 [Service]
diff --git a/data/snapper-sync.service b/data/snapper-sync.service
index eab35a47..028faca7 100644
--- a/data/snapper-sync.service
+++ b/data/snapper-sync.service
@@ -1,8 +1,8 @@
 [Unit]
 Description=Snapper Highest Snapshot Number Synchronization
 Documentation=man:snbk(8)
-After=snapperd.service
-Requires=snapperd.service
+Requires=dbus.service
+After=dbus.service
 
 [Service]
 Type=oneshot
diff --git a/data/timeline.service b/data/timeline.service
index f2f155b3..2b72dd74 100644
--- a/data/timeline.service
+++ b/data/timeline.service
@@ -1,6 +1,9 @@
 [Unit]
 Description=Timeline of Snapper Snapshots
 Documentation=man:snapper(8) man:snapper-configs(5)
+Requires=dbus.service
+After=dbus.service
+Requires=nss-user-lookup.target
 After=nss-user-lookup.target
 
 [Service]
diff --git a/package/snapper.changes b/package/snapper.changes
index 5de6a59d..32f16615 100644
--- a/package/snapper.changes
+++ b/package/snapper.changes
@@ -1,3 +1,8 @@
