From: Hideki Yamane <henrich@debian.org>
Date: Sun, 15 Aug 2021 14:56:57 +0900
Subject: Add some missing systemd unit directives

---
 data/boot.service     | 1 +
 data/snapperd.service | 3 +++
 2 files changed, 4 insertions(+)

Index: snapper/data/boot.service
===================================================================
--- snapper.orig/data/boot.service
+++ snapper/data/boot.service
@@ -1,6 +1,7 @@
 [Unit]
 Description=Take snapper snapshot of root on boot
 ConditionPathExists=/etc/snapper/configs/root
+Documentation=man:snapper(8)
 
 [Service]
 Type=oneshot
Index: snapper/data/snapperd.service
===================================================================
--- snapper.orig/data/snapperd.service
+++ snapper/data/snapperd.service
@@ -14,3 +14,6 @@ PrivateNetwork=true
 ProtectHostname=true
 RestrictAddressFamilies=AF_UNIX
 RestrictRealtime=true
+
+[Install]
+WantedBy=sysinit.target
