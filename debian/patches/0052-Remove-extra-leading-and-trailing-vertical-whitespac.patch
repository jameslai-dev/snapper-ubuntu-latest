From 43e670e0c01596b2cda1c66a76138548a05f6f46 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jo=C3=A3o=20Guerra?= <joca-bt@users.noreply.github.com>
Date: Sun, 25 Jan 2026 12:33:05 +0100
Subject: [PATCH 52/74] Remove extra leading and trailing vertical whitespace
 in some of the systemd timers

---
 data/backup.timer   | 2 --
 data/cleanup.timer  | 2 --
 data/timeline.timer | 2 --
 3 files changed, 6 deletions(-)

diff --git a/data/backup.timer b/data/backup.timer
index a50d4fce..cd92e873 100644
--- a/data/backup.timer
+++ b/data/backup.timer
@@ -1,4 +1,3 @@
-
 [Unit]
 Description=Backup of Snapper Snapshots
 Documentation=man:snbk(5)
@@ -8,4 +7,3 @@ OnCalendar=hourly
 
 [Install]
 WantedBy=timers.target
-
diff --git a/data/cleanup.timer b/data/cleanup.timer
index 174f1f69..449a1c53 100644
--- a/data/cleanup.timer
+++ b/data/cleanup.timer
@@ -1,4 +1,3 @@
-
 [Unit]
 Description=Hourly Cleanup of Snapper Snapshots
 Documentation=man:snapper(8) man:snapper-configs(5)
@@ -9,4 +8,3 @@ OnUnitActiveSec=1h
 
 [Install]
 WantedBy=timers.target
-
diff --git a/data/timeline.timer b/data/timeline.timer
index 0569645d..4a186915 100644
--- a/data/timeline.timer
+++ b/data/timeline.timer
@@ -1,4 +1,3 @@
-
 [Unit]
 Description=Timeline of Snapper Snapshots
 Documentation=man:snapper(8) man:snapper-configs(5)
@@ -8,4 +7,3 @@ OnCalendar=hourly
 
 [Install]
 WantedBy=timers.target
-
