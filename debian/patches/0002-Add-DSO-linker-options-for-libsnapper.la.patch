From: Nicolas Dandrimont <nicolas.dandrimont@crans.org>
Date: Wed, 4 Dec 2013 23:15:39 +0100
Subject: Add DSO linker options for libsnapper.la

---
 client/Makefile.am           | 4 ++--
 client/utils/Makefile.am     | 2 +-
 examples/c++-lib/Makefile.am | 2 +-
 server/Makefile.am           | 2 +-
 testsuite-cmp/Makefile.am    | 2 +-
 testsuite-real/Makefile.am   | 2 +-
 testsuite/Makefile.am        | 2 +-
 7 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/client/Makefile.am b/client/Makefile.am
index ed05cc2..d4cdf46 100644
--- a/client/Makefile.am
+++ b/client/Makefile.am
@@ -16,7 +16,7 @@ snapper_SOURCES =			\
 	misc.cc		misc.h		\
 	errors.cc	errors.h
 
-snapper_LDADD = ../snapper/libsnapper.la utils/libutils.la ../dbus/libdbus.la
+snapper_LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm utils/libutils.la ../dbus/libdbus.la
 
 noinst_PROGRAMS = systemd-helper
 
@@ -27,5 +27,5 @@ systemd_helper_SOURCES =		\
 	cleanup.cc	cleanup.h	\
 	errors.cc	errors.h
 
-systemd_helper_LDADD = ../snapper/libsnapper.la utils/libutils.la ../dbus/libdbus.la
+systemd_helper_LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm utils/libutils.la ../dbus/libdbus.la
 
diff --git a/client/utils/Makefile.am b/client/utils/Makefile.am
index aeda1fa..150cff5 100644
--- a/client/utils/Makefile.am
+++ b/client/utils/Makefile.am
@@ -12,5 +12,5 @@ libutils_la_SOURCES =			\
 	console.cc	console.h	\
 	GetOpts.cc	GetOpts.h
 
-libutils_la_LIBADD = ../../snapper/libsnapper.la
+libutils_la_LIBADD = ../../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
diff --git a/examples/c++-lib/Makefile.am b/examples/c++-lib/Makefile.am
index 03d1b33..7cc7195 100644
--- a/examples/c++-lib/Makefile.am
+++ b/examples/c++-lib/Makefile.am
@@ -4,7 +4,7 @@
 
 INCLUDES = -I$(top_srcdir)
 
-LDADD = ../../snapper/libsnapper.la
+LDADD = ../../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 noinst_PROGRAMS = List ListAll Create CmpDirs CreateNumber CreateTimeline SnapTest
 
diff --git a/server/Makefile.am b/server/Makefile.am
index 00d1e81..9a5433a 100644
--- a/server/Makefile.am
+++ b/server/Makefile.am
@@ -14,5 +14,5 @@ snapperd_SOURCES =					\
 	Background.cc		Background.h		\
 	Types.cc		Types.h
 
-snapperd_LDADD = ../snapper/libsnapper.la ../dbus/libdbus.la -lrt
+snapperd_LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm ../dbus/libdbus.la -lrt
 
diff --git a/testsuite-cmp/Makefile.am b/testsuite-cmp/Makefile.am
index 14df3a5..9b619a5 100644
--- a/testsuite-cmp/Makefile.am
+++ b/testsuite-cmp/Makefile.am
@@ -4,7 +4,7 @@
 
 INCLUDES = -I$(top_srcdir)
 
-LDADD = ../snapper/libsnapper.la
+LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 noinst_SCRIPTS = run-all
 
diff --git a/testsuite-real/Makefile.am b/testsuite-real/Makefile.am
index 6de5563..bcde03d 100644
--- a/testsuite-real/Makefile.am
+++ b/testsuite-real/Makefile.am
@@ -6,7 +6,7 @@ CXXFLAGS += -std=gnu++0x
 
 INCLUDES = -I$(top_srcdir)
 
-LDADD = ../snapper/libsnapper.la
+LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 if HAVE_XATTRS
 TMP_XATST = xattrs1 xattrs2 xattrs3 xattrs4
diff --git a/testsuite/Makefile.am b/testsuite/Makefile.am
index af16005..9510fc7 100644
--- a/testsuite/Makefile.am
+++ b/testsuite/Makefile.am
@@ -6,7 +6,7 @@ CXXFLAGS += -std=gnu++0x
 
 INCLUDES = -I$(top_srcdir)
 
-LDADD = ../snapper/libsnapper.la
+LDADD = ../snapper/libsnapper.la -lboost_thread -lboost_system -lxml2 -lacl -lz -lm
 
 noinst_SCRIPTS = run-all
 
