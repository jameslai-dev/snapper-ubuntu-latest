From fc6d4c6e4f3cb9a48878509aaa85729c1634aec3 Mon Sep 17 00:00:00 2001
From: Arvin Schnell <aschnell@suse.de>
Date: Tue, 18 Nov 2025 10:25:06 +0100
Subject: [PATCH] - add CAP_MKNOD in snapper-backup.service

---
 data/backup.service     | 2 +-
 package/snapper.changes | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/data/backup.service b/data/backup.service
index cb136fb..87b5e47 100644
--- a/data/backup.service
+++ b/data/backup.service
@@ -8,7 +8,7 @@ Type=simple
 WorkingDirectory=/root
 ExecStart=/usr/sbin/snbk --verbose --automatic transfer-and-delete
 
-CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_FSETID CAP_SETFCAP CAP_SYS_ADMIN CAP_SYS_MODULE CAP_IPC_LOCK CAP_SYS_NICE
+CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_FSETID CAP_SETFCAP CAP_SYS_ADMIN CAP_SYS_MODULE CAP_IPC_LOCK CAP_SYS_NICE CAP_MKNOD
 LockPersonality=true
 NoNewPrivileges=false
 ProtectHostname=true
diff --git a/package/snapper.changes b/package/snapper.changes
index 7cc3cd4..795c786 100644
--- a/package/snapper.changes
+++ b/package/snapper.changes
@@ -1,3 +1,9 @@
+-------------------------------------------------------------------
+Tue Nov 18 10:23:16 CET 2025 - aschnell@suse.com
+
+- add CAP_MKNOD in snapper-backup.service
+  (gh#openSUSE/snapper#1067)
+
 -------------------------------------------------------------------
